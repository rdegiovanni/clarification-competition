│     integer_part, decimal_part = s.split('.', 1)                                                                                                                                  │
│     # Remove trailing zeros from decimal part to avoid float repr quirks                                                                                                          │
│     decimal_part = decimal_part.rstrip('0')                                                                                                                                       │
│     # After stripping trailing zeros, decimal_part may be empty; but we want exactly two decimals                                                                                 │
