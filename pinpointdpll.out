│ ```python                                                                                                                                                                         │
│ def is_decimal(value):                                                                                                                                                            │
│     try:                                                                                                                                                                          │
│         s = str(float(value))                                                                                                                                                     │
│     except (ValueError, TypeError):                                                                                                                                               │
│         return False                                                                                                                                                              │
│     if '.' not in s:                                                                                                                                                              │
│         return False                                                                                                                                                              │
│     integer_part, decimal_part = s.split('.', 1)                                                                                                                                  │
│     # Remove trailing zeros from decimal part to avoid float repr quirks                                                                                                          │
│     decimal_part = decimal_part.rstrip('0')                                                                                                                                       │
│     # After stripping trailing zeros, decimal_part may be empty; but we want exactly two decimals                                                                                 │
│     # So we check the original string representation                                                                                                                              │
│     # Instead, use format to get exact decimal places                                                                                                                             │
│     try:                                                                                                                                                                          │
│         formatted = f"{float(value):.2f}"                                                                                                                                         │
│     except (ValueError, TypeError):                                                                                                                                               │
│         return False                                                                                                                                                              │
│     # Check if the formatted string matches the original after float conversion                                                                                                   │
│     # But this might fail for inputs like "1.00" vs "1.0"                                                                                                                         │
│     # So better to check that the input value is numeric and has exactly two decimals when formatted                                                                              │
│     # Finally, check that the value equals the formatted value converted to float                                                                                                 │
│     # and that the formatted string has exactly two decimals                                                                                                                      │
│     # So:                                                                                                                                                                         │
│     # 1) Check that formatted string has exactly 2 decimals                                                                                                                       │
│     # 2) Check that float(value) == float(formatted)                                                                                                                              │
│     # 3) Check that value can be parsed as float                                                                                                                                  │
│     # This ensures value is numeric and exactly two decimals.                                                                                                                     │
│     # But user might pass int or float; if int, no decimals.                                                                                                                      │
│     # So we rely on formatted string only.                                                                                                                                        │
│     # To be strict, parse input as string and check decimals:                                                                                                                     │
│     s_val = str(value)                                                                                                                                                            │
│     if '.' not in s_val:                                                                                                                                                          │
│         return False                                                                                                                                                              │
│     # Check decimals count in string representation                                                                                                                               │
│     decimals = s_val.split('.', 1)[1]                                                                                                                                             │
│     # Handle possible trailing zeros - but task says exactly two decimals, so treat trailing zeros as decimals                                                                    │
│     if len(decimals) != 2:                                                                                                                                                        │
│         return False                                                                                                                                                              │
│     # Check that value can be converted to float and matches formatted float with 2 decimals                                                                                      │
│     try:                                                                                                                                                                          │
│         f_val = float(value)                                                                                                                                                      │
│     except Exception:                                                                                                                                                             │
│         return False                                                                                                                                                              │
│     return f"{f_val:.2f}" == formatted                                                                                                                                            │
│ ```                                                                                                                                                                               │
