│         return 0                                                                                                                                                                  │
│     if 47 * 47 <= n and n % 47 == 0:                                                                                                                                              │
│         return 0                                                                                                                                                                  │
│     return 1                                                                                                                                                                      │
│ ```                                                                                                                                                                               │
